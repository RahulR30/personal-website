# Powers the natural-language search on the explore canvas (/api/match) and the
# per-node Q&A on each result card (/api/ask).
#
# Get a free key at https://aistudio.google.com/apikey — no billing account or
# credit card required on the free tier.
#
# Local dev:  copy this file to .env.local and paste your key below.
# Production: set it in Vercel → Project → Settings → Environment Variables.
#
# Never commit the real key — .env.local is gitignored.
# Without this set, the rest of the site works normally and the search returns
# "Search is not configured on this deployment."
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash. Google retires model aliases
# periodically; a retired one returns 404 naming its replacement, which you can
# then set here without a code change.
# GEMINI_MODEL=gemini-3.6-flash
